# Caddy in front of Tax Assist US (docker-compose.yml): the browser's login
# popup, then everything passes through to taxassist, which has no login of
# its own.
#
# The login comes from .env (TAXASSIST_LOGIN_USER and TAXASSIST_LOGIN_HASH,
# a bcrypt hash), passed in by docker-compose.yml. Without them compose
# refuses to start, so Tax Assist US is never served without the login.
{
	admin off
	auto_https off
}

:80 {
	basic_auth {
		{$TAXASSIST_LOGIN_USER} {$TAXASSIST_LOGIN_HASH}
	}

	header {
		X-Frame-Options "DENY"
		-Server
	}

	# Caddy keeps the browser's Host header, which taxassist.py checks against TAXASSIST_HOSTS.
	reverse_proxy taxassist:8765
}
