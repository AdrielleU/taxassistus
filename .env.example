# Copy to .env (git ignores it) and fill in. Used by docker-compose.yml.

# The name people type in the browser: a DNS name (taxes.example.com) or the server's LAN IP.
TAXASSIST_DOMAIN=taxes.example.com

# internal = Caddy's own certificate (LAN or VPN; each browser warns once).
# Your email = real Let's Encrypt certificate (needs public DNS and ports 80/443 reachable).
TAXASSIST_TLS=internal

# One shared login. Make the hash with:
#   docker run --rm docker.io/library/caddy:2.8-alpine caddy hash-password --plaintext 'a long passphrase'
# Keep the single quotes: the hash contains $ signs.
TAXASSIST_USER=taxes
TAXASSIST_PASSWORD_HASH='$2a$14$replace.this.with.the.output.of.caddy.hash-password'

# Host ports. Rootless Podman can't use ports below 1024 by default: use 8080 and 8443.
TAXASSIST_HTTP_PORT=80
TAXASSIST_HTTPS_PORT=443

# Who owns files the app writes in my_tax_files/ (run `id -u` and `id -g`).
# Rootless Podman: use 0 and 0 (container root is your own user there).
TAXASSIST_UID=1000
TAXASSIST_GID=1000
