# Copy to .env (git ignores it) and fill in. Used by docker-compose.yml.

# Every name or IP people type in the browser, comma-separated, without the port:
# the server's LAN IP, its host name, and localhost. Others get a 403.
TAXASSIST_HOSTS=192.168.1.10,my-server,localhost

# Which release of the image (ghcr.io/adrielleu/taxassistus) to run: a version from
# https://github.com/AdrielleU/taxassistus/releases, e.g. 1.4.0. Then: podman-compose pull && podman-compose up -d
TAXASSIST_TAG=latest

# Who owns files the app writes in my_tax_files/ (run `id -u` and `id -g`).
# Rootless Podman: use 0 and 0 (container root is your own user there).
TAXASSIST_UID=1000
TAXASSIST_GID=1000

# The login (Caddy's popup). The password is stored only as a bcrypt hash, never in plain text.
# 1. Paste this command exactly as it is (Podman: podman instead of docker). Do NOT put your password in it:
#      docker run --rm -it docker.io/library/caddy:2.11.7-alpine sh -c 'h=$(caddy hash-password) && printf "TAXASSIST_LOGIN_HASH=\047%s\047\n" "$h"'
#    It then asks; type the password at the prompts (nothing shows; use 12+ characters):
#      Enter password:      <- your password, Enter
#      Confirm password:    <- the same again, Enter
#      TAXASSIST_LOGIN_HASH='$2a$14$...'    <- the finished line, quotes included: copy all of it
# 2. Paste that line over TAXASSIST_LOGIN_HASH= below, and set your username in TAXASSIST_LOGIN_USER=
# 3. Restart so the login uses it: podman-compose up -d   (Docker: docker compose up -d)
TAXASSIST_LOGIN_USER=admin
TAXASSIST_LOGIN_HASH=
