#!/bin/sh
# Tax Assist US: refuse to commit private tax data, even with `git add -f`.
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  lf=$(printf '%s' "$f" | tr 'A-Z' 'a-z')  # match extensions in any case (iPhones save .HEIC/.JPG)
  case "$lf" in
    my_tax_files/readme.md) ;;
    my_tax_files/*) echo "BLOCKED: $f is a private tax file"; fail=1 ;;
    *.pdf|*.jpg|*.jpeg|*.heic|*.png|*.webp|*.tif|*.tiff|*.xls|*.xlsx|*.ods|*.ofx|*.qfx|*.qbo|*.zip)
      echo "BLOCKED: $f looks like a tax document, receipt, spreadsheet or bank export"; fail=1 ;;
    templates/*|state_tax_rates.csv) ;;  # templates and the public state rate table
    profile.yml|*/profile.yml|status.js|*/status.js) echo "BLOCKED: $f is personal data (profile or folder snapshot)"; fail=1 ;;
    *_TaxDocs/*) echo "BLOCKED: $f is inside a tax year folder"; fail=1 ;;
    *.csv) echo "BLOCKED: $f looks like a ledger (only templates/ CSVs are allowed)"; fail=1 ;;
  esac
done
# Social Security / ITIN numbers (NNN-NN-NNNN) and EINs (NN-NNNNNNN) in staged text
if git diff --cached -U0 | grep -aE '^\+' | grep -aEq '\b[0-9]{3}-[0-9]{2}-[0-9]{4}\b|\b[0-9]{2}-[0-9]{7}\b'; then
  echo "BLOCKED: staged changes contain something shaped like an SSN or EIN"; fail=1
fi
if [ $fail -ne 0 ]; then
  echo "Nothing was committed. Private files belong in my_tax_files/ (see guides/1_files.md)."
  exit 1
fi
